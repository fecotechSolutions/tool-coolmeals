# =============================================================================
# Cool Meals Leads — copy to `.env` in the repo root:
#   cp .env.example .env
#
# Local = DEV (Supabase otbyuvbdajqrcrtwlwvy + Kapso sandbox).
# Vercel Production = PROD (Supabase jrsvfyujpuuhnwzjubow + WhatsApp …5440).
# Nunca pegues keys de PROD en tu `.env` local.
# Guía completa: docs/environments.md
# =============================================================================

# --- Entorno de producto ---
# development | staging | production
# Local: development · Vercel prod: production
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# --- Mode (web) ---
# true  = UI con mocks (sin API) — solo demos rápidas
# false = UI → API → Supabase (flujo normal DEV/PROD)
NEXT_PUBLIC_DEMO_MODE=false

# --- Supabase (usar proyecto DEV en local) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Local API + CORS ---
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Local + URL prod web (CORS). En Vercel prod: solo el dominio prod.
CORS_ORIGINS=http://localhost:3000,https://tool-coolmeals-web.vercel.app

# Optional until Auth
# INTERNAL_API_SECRET=change-me-in-production

# --- Kapso (WhatsApp) — API only ---
# DEV: phone_number_id del Sandbox
# PROD (Vercel + function Kapso): phone_number_id del número …440
KAPSO_API_BASE_URL=https://api.kapso.ai
KAPSO_API_KEY=your-kapso-project-api-key
KAPSO_PHONE_NUMBER_ID=your-kapso-sandbox-or-prod-phone-number-id
# KAPSO_WORKFLOW_ID=454904ce-8fba-423f-bf08-32135f694b14

# Horas en handoff / timeouts (defaults en código si se omiten)
# DERIVE_HANDOFF_HOURS=24
# ABANDONED_TO_WAITING_HOURS=22
# ESPERANDO_TO_FINALIZE_HOURS=22
# ABANDONED_NUDGE_MESSAGE=Hola! ¿Tenés alguna consulta más? Si no recibimos respuesta, vamos a cerrar esta conversación. Quedamos atentos.
# STUCK_RUNNING_MINUTES=3
# CRON_SECRET=change-me-for-cron-endpoint

# Sandbox wipe — SOLO DEV. En APP_ENV=production el endpoint se bloquea en código.
# SANDBOX_RESET_ENABLED=false
# SANDBOX_RESET_UNTIL=2026-08-20T00:00:00-03:00
# SANDBOX_RESET_PHONES=+543513053755,+54911...

# --- Google Sheets — API only ---
# DEV: hojas TEST (copias). PROD: hojas oficiales.
# GOOGLE_SHEET_DERIVED_DISTRIBUTORS_ID=
# GOOGLE_SHEET_SAMPLE_LOGISTICS_ID=
# GOOGLE_SHEET_COMMERCIAL_ATTENTION_ID=
# GOOGLE_SHEET_NO_COVERAGE_ID=
# GOOGLE_SHEETS_RANGE=Sheet1
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# GOOGLE_SHEETS_WEBHOOK_SECRET=una-frase-secreta-larga
