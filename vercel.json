{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @coolmeals/shared && npm run build:api:handler",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/((?!api/cron/).*)", "destination": "/api/handler" }
  ],
  "functions": {
    "api/handler.js": {
      "maxDuration": 60
    },
    "api/cron/pipeline-timeouts.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/pipeline-timeouts",
      "schedule": "0 14 * * *"
    }
  ]
}
